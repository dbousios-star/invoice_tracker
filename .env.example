# OpenAI-compatible Vision API
# Gemini:      API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   MODEL_NAME=gemini-flash-latest
# OpenAI:      API_BASE_URL=https://api.openai.com/v1                                  MODEL_NAME=gpt-4o-mini
# OpenRouter:  API_BASE_URL=https://openrouter.ai/api/v1                               MODEL_NAME=google/gemini-flash-latest
API_KEY=
API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_NAME=gemini-flash-latest

# Price change is reported only when BOTH thresholds are exceeded
PRICE_THRESHOLD_PERCENT=0.5
PRICE_THRESHOLD_AMOUNT=0.02
